{
    "compilerOptions": {
      "target": "ESNext",
      "module": "commonjs",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "types": ["node", "@playwright/test"],
      "skipLibCheck": true
    },
    "include": [
      "tests/**/*.ts",
      "src/**/*.ts",
      "playwright.config.ts"
    ]
  }